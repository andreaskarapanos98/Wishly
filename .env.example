# Copy this file to .env.local and fill in the values.
# All three are PUBLIC keys: they are designed to be shipped to the browser.
# Never put a Clerk *secret* key or the Supabase *service_role* key here.

# Clerk → Dashboard → Configure → API keys → "Publishable key"
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API (or "Connect")
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
